---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  type: string;
  date: Date;
  meta?: string[];
  ledger?: string;
  video?: string;
  repo?: string;
  demo?: string;
}
const { title, description, type, date, meta = [], ledger, video, repo, demo } = Astro.props;

const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');
const hasLinks = video || repo || demo;
---
<BaseLayout title={`${title} — ${type}`} description={description}>
  <article class="container">
    <header class="article-head">
      <div class="article-meta">
        <span class="type">{type}</span>
        <span class="sep">·</span>
        <span>{fmt(date)}</span>
        {meta.map((m) => (
          <>
            <span class="sep">·</span>
            <span>{m}</span>
          </>
        ))}
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-lede">{description}</p>
    </header>

    {hasLinks && (
      <div style="display: flex; gap: 12px; margin-bottom: 40px; flex-wrap: wrap;">
        {video && <a href={video} class="btn primary" target="_blank" rel="noopener">Watch video <span class="arrow">↗</span></a>}
        {repo && <a href={repo} class="btn" target="_blank" rel="noopener">Repository <span class="arrow">↗</span></a>}
        {demo && <a href={demo} class="btn" target="_blank" rel="noopener">Live demo <span class="arrow">↗</span></a>}
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <div style="padding: 80px 0 40px; border-top: 1px solid var(--rule); margin-top: 80px;">
      <a href={ledger ?? '/'} class="btn">
        <span class="arrow">←</span> Back
      </a>
    </div>
  </article>
</BaseLayout>
