---
import '@/styles/global.css';
import { site } from '@/data/site';
import TopBar from '@/components/TopBar.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}
const {
  title = `${site.name} — ${site.roleLong}`,
  description = 'Vulnerability researcher and offensive security engineer. CVEs, writeups, and open-source tooling.',
  path = Astro.url.pathname,
} = Astro.props;
const ogImage = new URL(site.photo, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={new URL(path, Astro.site)} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={new URL(path, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#080706" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <TopBar path={path} />
  <slot />
  <Footer />

  <script>
    const rv = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); rv.unobserve(e.target); }
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.rv').forEach(el => rv.observe(el));
  </script>
</body>
</html>
